# 复制为服务器 /opt/fitmate/.env 后填写真实值；不要提交真实 .env。

# DOMAIN 是 Caddy 对外申请 HTTPS 证书和接收请求的域名，不带 https://。
DOMAIN=fitmate.example.com

# APP_IMAGE 是 Next.js standalone 应用镜像，GitHub Actions 会更新为具体 commit tag。
APP_IMAGE=ghcr.io/example-owner/fitmate:latest

# OPS_IMAGE 是运维镜像，包含 Prisma CLI、migration、seed 和 embedding 刷新脚本。
OPS_IMAGE=ghcr.io/example-owner/fitmate-ops:latest

# POSTGRES_DB 是 PostgreSQL 首次初始化创建的数据库名。
POSTGRES_DB=fitmate

# POSTGRES_USER 是应用连接 PostgreSQL 的用户名。
POSTGRES_USER=fitmate

# POSTGRES_PASSWORD 是 PostgreSQL 密码，必须使用强随机值。
POSTGRES_PASSWORD=change-me-to-a-strong-random-password

# DATABASE_URL 是应用和 Prisma CLI 使用的连接串；主机名 db 来自 docker-compose 服务名。
DATABASE_URL=postgresql://fitmate:change-me-to-a-strong-random-password@db:5432/fitmate?schema=public

# DEEPSEEK_API_KEY 是生产 /api/chat 调用真实模型的必填密钥。
DEEPSEEK_API_KEY=change-me-to-your-deepseek-api-key

# DEEPSEEK_API_URL 可选；留空时使用代码中的默认 DeepSeek endpoint。
DEEPSEEK_API_URL=

# DEEPSEEK_MODEL 可选；留空时使用集中配置中的默认模型。
DEEPSEEK_MODEL=

# FITMATE_LOCAL_AUTH_SECRET 用于签发本地匿名 auth cookie；生产环境必须填写强随机字符串。
FITMATE_LOCAL_AUTH_SECRET=change-me-to-a-strong-random-secret

# CONFIRMATION_TOKEN_SECRET 用于高影响操作确认 token 签名；生产环境应显式填写强随机字符串。
CONFIRMATION_TOKEN_SECRET=change-me-to-a-strong-random-secret

# EXERCISE_IMAGE_LOCAL_DIR 是 app 容器内动作图片读取目录，默认与镜像内目录一致。
EXERCISE_IMAGE_LOCAL_DIR=exercises_picture

# EXERCISE_IMAGE_PUBLIC_BASE_URL 是前端访问动作图片的基础 URL；默认走站内受控 Route。
EXERCISE_IMAGE_PUBLIC_BASE_URL=/api/exercise-images

# ENABLE_AI_TRACE_LOG 控制生产环境是否写入 AI trace；公开环境建议保持 false。
ENABLE_AI_TRACE_LOG=false

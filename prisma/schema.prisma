generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum AuthProvider {
  credentials
  google
  github
  apple
  anonymous
}

enum ExerciseReviewStatus {
  machine_translated
  machine_assisted
  human_reviewed
  rejected
  fallback
}

enum WorkoutRoutineStatus {
  active
  archived
}

enum WorkoutRoutineSource {
  ai
  manual
  imported
}

enum WorkoutScheduleStatus {
  planned
  completed
  missed
  cancelled
  rest
}

enum WorkoutSessionResultStatus {
  completed
  abandoned
}

enum ChatMessageRole {
  system
  user
  assistant
  tool
}

enum ConversationArtifactKind {
  exercise_recommendation
  routine
  plan
}

enum ConversationArtifactScope {
  chat
}

enum ConversationArtifactStatus {
  active
  superseded
  archived
}

enum ConversationArtifactSourceEntityKind {
  workout_routine
  workout_schedule
}

enum UserMemoryKind {
  explicit_preference
  exercise_feedback
  constraint
  temporary_context
  injury_or_pain_signal
  training_behavior
}

enum UserMemorySubjectType {
  exercise
  body_part
  goal
  equipment
  schedule
  health
  general
}

enum UserMemorySource {
  chat
  workout_result
  profile
  system
}

enum UserMemoryStatus {
  active
  pending_confirmation
  dismissed
  expired
}

enum UserExerciseFeedbackKind {
  dislike
  too_hard
  too_easy
  pain
  skipped
  completed
}

model User {
  id              String                 @id @default(cuid())
  email           String?                @unique
  displayName     String?
  deletedAt       DateTime?              @db.Timestamptz(3)
  createdAt       DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime               @updatedAt @db.Timestamptz(3)
  identities      UserIdentity[]
  profile         UserProfile?
  routines        WorkoutRoutine[]
  schedules       WorkoutSchedule[]
  results         WorkoutSessionResult[]
  chatSessions    ChatSession[]
  artifacts       ConversationArtifact[]
  artifactIndexes ArtifactIndex[]
  memories        UserMemory[]
  exerciseFeedback UserExerciseFeedback[]

  @@index([deletedAt])
}

model UserIdentity {
  id                String       @id @default(cuid())
  userId            String
  provider          AuthProvider
  providerAccountId String
  email             String?
  emailVerifiedAt   DateTime?    @db.Timestamptz(3)
  createdAt         DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime     @updatedAt @db.Timestamptz(3)
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@index([email])
}

model UserProfile {
  id                String   @id @default(cuid())
  userId            String   @unique
  goal              String?
  experience        String?
  sessionMinutes    Int?
  weeklyFrequency   Int?
  equipment         String[] @default([])
  injuryLimitations String[] @default([])
  preferences       String[] @default([])
  avoidances        String[] @default([])
  createdAt         DateTime @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @db.Timestamptz(3)
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Exercise {
  id                 String               @id
  source             String
  sourceUrl          String
  sourceId           String
  license            String
  nameEn             String
  nameZh             String
  category           String?
  categoryZh         String?
  level              String?
  levelZh            String?
  force              String?
  forceZh            String?
  mechanic           String?
  mechanicZh         String?
  equipment          String?
  equipmentZh        String?
  homeRequirement    String
  homeRequirementZh  String
  primaryMuscles     String[]             @default([])
  primaryMusclesZh   String[]             @default([])
  secondaryMuscles   String[]             @default([])
  secondaryMusclesZh String[]             @default([])
  instructionsEn     String[]             @default([])
  instructionsZh     String[]             @default([])
  images             String[]             @default([])
  imageUrls          String[]             @default([])
  allowedSections    String[]             @default([])
  intensityRole      String?
  movementPattern    String?
  difficulty         String?
  riskTags           String[]             @default([])
  contraindications  String[]             @default([])
  regressionExerciseIds String[]          @default([])
  progressionExerciseIds String[]         @default([])
  substitutionGroupId String?
  goalTags           String[]             @default([])
  embeddingText      String?
  embedding          Json?
  reviewStatus       ExerciseReviewStatus @default(machine_translated)
  isPublished        Boolean              @default(false)
  createdAt          DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime             @updatedAt @db.Timestamptz(3)
  workoutItems       WorkoutRoutineItem[]
  userFeedback       UserExerciseFeedback[]

  @@unique([source, sourceId])
  @@index([category])
  @@index([level])
  @@index([equipment])
  @@index([reviewStatus])
  @@index([isPublished])
  @@index([embeddingText])
}

model UserMemory {
  id                   String                @id @default(cuid())
  userId               String
  kind                 UserMemoryKind
  subjectType          UserMemorySubjectType @default(general)
  subjectId            String?
  subjectLabel         String?
  value                Json
  confidence           Float                 @default(1)
  source               UserMemorySource
  expiresAt            DateTime?             @db.Timestamptz(3)
  requiresConfirmation Boolean               @default(false)
  status               UserMemoryStatus      @default(active)
  createdAt            DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime              @updatedAt @db.Timestamptz(3)
  user                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind])
  @@index([userId, status])
  @@index([userId, subjectType, subjectId])
  @@index([expiresAt])
}

model UserExerciseFeedback {
  id                   String                   @id @default(cuid())
  userId               String
  exerciseId           String
  kind                 UserExerciseFeedbackKind
  value                Json
  confidence           Float                    @default(1)
  source               UserMemorySource
  expiresAt            DateTime?                @db.Timestamptz(3)
  requiresConfirmation Boolean                  @default(false)
  status               UserMemoryStatus         @default(active)
  createdAt            DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime                 @updatedAt @db.Timestamptz(3)
  user                 User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercise             Exercise                 @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@index([userId, kind])
  @@index([userId, status])
  @@index([userId, exerciseId])
  @@index([exerciseId])
  @@index([expiresAt])
}

model WorkoutRoutine {
  id                      String            @id @default(cuid())
  userId                  String
  title                   String
  summary                 String?
  estimatedMinutes        Int
  estimatedCalories       Int               @default(0)
  status                  WorkoutRoutineStatus @default(active)
  source                  WorkoutRoutineSource @default(ai)
  trainingLoopRounds      Int?
  trainingLoopRestSeconds Int?
  warmupToTrainingRestSeconds Int?
  trainingToStretchRestSeconds Int?
  sourceAiTraceId         String?
  createdAt               DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt               DateTime          @updatedAt @db.Timestamptz(3)
  user                    User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  items                   WorkoutRoutineItem[]
  schedules               WorkoutSchedule[]
  results                 WorkoutSessionResult[]

  @@index([userId])
  @@index([status])
}

model WorkoutRoutineItem {
  id                    String         @id @default(cuid())
  routineId             String
  exerciseId            String
  mode                  String
  target                Int
  sets                  Int
  setRestSeconds        Int
  transitionRestSeconds Int
  section               String?
  notes                 String?
  sortOrder             Int
  createdAt             DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime       @updatedAt @db.Timestamptz(3)
  routine               WorkoutRoutine @relation(fields: [routineId], references: [id], onDelete: Cascade)
  exercise              Exercise       @relation(fields: [exerciseId], references: [id], onDelete: Restrict)

  @@unique([routineId, sortOrder])
  @@index([exerciseId])
  @@index([routineId, sortOrder])
}

model WorkoutSchedule {
  id              String               @id @default(cuid())
  userId          String
  routineId       String?
  scheduledFor    DateTime             @db.Timestamptz(3)
  status          WorkoutScheduleStatus @default(planned)
  titleSnapshot   String
  estimatedMinutes Int               @default(0)
  estimatedCalories Int              @default(0)
  createdAt       DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime             @updatedAt @db.Timestamptz(3)
  user            User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  routine         WorkoutRoutine?      @relation(fields: [routineId], references: [id], onDelete: SetNull)
  result          WorkoutSessionResult?

  @@index([userId])
  @@index([status])
  @@index([scheduledFor])
  @@index([routineId])
}

model WorkoutSessionResult {
  id                     String                     @id @default(cuid())
  userId                 String
  scheduleId             String                     @unique
  routineId              String?
  startedAt              DateTime                   @db.Timestamptz(3)
  endedAt                DateTime                   @db.Timestamptz(3)
  durationSeconds        Int
  completedStepCount     Int
  totalStepCount         Int
  completedExerciseCount Int
  totalExerciseCount     Int
  estimatedCalories      Int
  actualCalories         Int?
  status                 WorkoutSessionResultStatus @default(completed)
  feedback               Json?
  createdAt              DateTime                   @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime                   @updatedAt @db.Timestamptz(3)
  user                   User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  schedule               WorkoutSchedule            @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  routine                WorkoutRoutine?            @relation(fields: [routineId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([routineId])
  @@index([status])
}

model ChatSession {
  id              String                 @id @default(cuid())
  userId          String
  title           String?
  createdAt       DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime               @updatedAt @db.Timestamptz(3)
  user            User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages        ChatMessage[]
  artifacts       ConversationArtifact[]
  artifactIndexes ArtifactIndex[]

  @@index([userId])
}

model ChatMessage {
  id            String                 @id @default(cuid())
  chatSessionId String
  role          ChatMessageRole
  content       String
  metadata      Json?
  createdAt     DateTime               @default(now()) @db.Timestamptz(3)
  chatSession   ChatSession            @relation(fields: [chatSessionId], references: [id], onDelete: Cascade)
  artifacts     ConversationArtifact[]

  @@index([chatSessionId, createdAt])
}

model ConversationArtifact {
  id                   String                               @id @default(cuid())
  userId               String
  sessionId            String
  messageId            String?
  kind                 ConversationArtifactKind
  scope                ConversationArtifactScope            @default(chat)
  payloadSchemaVersion Int
  payload              Json
  status               ConversationArtifactStatus           @default(active)
  revision             Int                                  @default(1)
  revisionOfArtifactId String?
  sourceEntityKind     ConversationArtifactSourceEntityKind?
  sourceEntityId       String?
  createdAt            DateTime                             @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime                             @updatedAt @db.Timestamptz(3)
  user                 User                                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  session              ChatSession                          @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  message              ChatMessage?                         @relation(fields: [messageId], references: [id], onDelete: SetNull)
  revisionOfArtifact   ConversationArtifact?                @relation("ArtifactRevision", fields: [revisionOfArtifactId], references: [id], onDelete: SetNull)
  revisions            ConversationArtifact[]               @relation("ArtifactRevision")
  index                ArtifactIndex?

  @@unique([messageId, kind, revision])
  @@index([userId, sessionId, status, updatedAt])
  @@index([messageId, kind, status])
  @@index([revisionOfArtifactId])
  @@index([sourceEntityKind, sourceEntityId])
}

model ArtifactIndex {
  id                   String                     @id @default(cuid())
  artifactId           String                     @unique
  userId               String
  sessionId            String
  kind                 ConversationArtifactKind
  scope                ConversationArtifactScope  @default(chat)
  status               ConversationArtifactStatus @default(active)
  title                String
  summary              String?
  exerciseIds          String[]                   @default([])
  goals                String[]                   @default([])
  muscles              String[]                   @default([])
  equipment            String[]                   @default([])
  sessionMinutes       Int?
  weeklyFrequency      Int?
  trainingDayCount     Int?
  sourceMessageId      String?
  embeddingText        String?
  embedding            Json?
  createdAt            DateTime                   @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime                   @updatedAt @db.Timestamptz(3)
  artifact             ConversationArtifact       @relation(fields: [artifactId], references: [id], onDelete: Cascade)
  user                 User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  session              ChatSession                @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([userId, sessionId, status, updatedAt])
  @@index([kind])
  @@index([sourceMessageId])
  @@index([embeddingText])
}

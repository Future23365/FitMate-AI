generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum AuthProvider {
  credentials
  google
  github
  apple
  anonymous
}

enum ExerciseReviewStatus {
  machine_translated
  machine_assisted
  human_reviewed
  rejected
  fallback
}

enum WorkoutPlanStatus {
  draft
  active
  archived
}

enum WorkoutPlanSource {
  ai
  manual
  imported
}

enum WorkoutSessionStatus {
  planned
  in_progress
  completed
  missed
  cancelled
  rest
}

enum ChatMessageRole {
  system
  user
  assistant
  tool
}

model User {
  id           String           @id @default(cuid())
  email        String?          @unique
  displayName  String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  identities   UserIdentity[]
  profile      UserProfile?
  workoutPlans WorkoutPlan[]
  sessions     WorkoutSession[]
  chatSessions ChatSession[]
}

model UserIdentity {
  id                String       @id @default(cuid())
  userId            String
  provider          AuthProvider
  providerAccountId String
  email             String?
  emailVerifiedAt   DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@index([email])
}

model UserProfile {
  id                String   @id @default(cuid())
  userId            String   @unique
  goal              String?
  experience        String?
  sessionMinutes    Int?
  weeklyFrequency   Int?
  equipment         String[] @default([])
  injuryLimitations String[] @default([])
  preferences       String[] @default([])
  avoidances        String[] @default([])
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Exercise {
  id                 String               @id
  source             String
  sourceUrl          String
  sourceId           String
  license            String
  nameEn             String
  nameZh             String
  category           String?
  categoryZh         String?
  level              String?
  levelZh            String?
  force              String?
  forceZh            String?
  mechanic           String?
  mechanicZh         String?
  equipment          String?
  equipmentZh        String?
  homeRequirement    String
  homeRequirementZh  String
  primaryMuscles     String[]             @default([])
  primaryMusclesZh   String[]             @default([])
  secondaryMuscles   String[]             @default([])
  secondaryMusclesZh String[]             @default([])
  instructionsEn     String[]             @default([])
  instructionsZh     String[]             @default([])
  images             String[]             @default([])
  imageUrls          String[]             @default([])
  riskTags           String[]             @default([])
  goalTags           String[]             @default([])
  reviewStatus       ExerciseReviewStatus @default(machine_translated)
  isPublished        Boolean              @default(false)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  workoutItems       WorkoutPlanItem[]

  @@unique([source, sourceId])
  @@index([category])
  @@index([level])
  @@index([equipment])
  @@index([reviewStatus])
  @@index([isPublished])
}

model WorkoutPlan {
  id                      String            @id @default(cuid())
  userId                  String
  title                   String
  goal                    String
  summary                 String?
  weeklyFrequency         Int
  estimatedSessionMinutes Int
  status                  WorkoutPlanStatus @default(draft)
  source                  WorkoutPlanSource @default(ai)
  safetyNotes             String[]          @default([])
  trainingLoopRounds      Int?
  trainingLoopRestSeconds Int?
  sourceAiTraceId         String?
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt
  user                    User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  days                    WorkoutPlanDay[]
  sessions                WorkoutSession[]

  @@index([userId])
  @@index([status])
}

model WorkoutPlanDay {
  id               String            @id @default(cuid())
  workoutPlanId    String
  dayIndex         Int
  title            String
  focus            String
  estimatedMinutes Int
  safetyNotes      String[]          @default([])
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  workoutPlan      WorkoutPlan       @relation(fields: [workoutPlanId], references: [id], onDelete: Cascade)
  items            WorkoutPlanItem[]

  @@unique([workoutPlanId, dayIndex])
}

model WorkoutPlanItem {
  id                    String         @id @default(cuid())
  workoutPlanDayId      String
  exerciseId            String
  mode                  String
  target                Int
  sets                  Int
  setRestSeconds        Int
  transitionRestSeconds Int
  section               String?
  notes                 String?
  sortOrder             Int
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  workoutPlanDay        WorkoutPlanDay @relation(fields: [workoutPlanDayId], references: [id], onDelete: Cascade)
  exercise              Exercise       @relation(fields: [exerciseId], references: [id], onDelete: Restrict)

  @@unique([workoutPlanDayId, sortOrder])
  @@index([exerciseId])
  @@index([workoutPlanDayId, sortOrder])
}

model WorkoutSession {
  id              String               @id @default(cuid())
  userId          String
  workoutPlanId   String?
  scheduledFor    DateTime?
  startedAt       DateTime?
  endedAt         DateTime?
  status          WorkoutSessionStatus @default(planned)
  durationSeconds Int?
  feedback        Json?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  user            User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  workoutPlan     WorkoutPlan?         @relation(fields: [workoutPlanId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status])
  @@index([scheduledFor])
}

model ChatSession {
  id        String        @id @default(cuid())
  userId    String
  title     String?
  metadata  Json?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  ChatMessage[]

  @@index([userId])
}

model ChatMessage {
  id            String          @id @default(cuid())
  chatSessionId String
  role          ChatMessageRole
  content       String
  metadata      Json?
  createdAt     DateTime        @default(now())
  chatSession   ChatSession     @relation(fields: [chatSessionId], references: [id], onDelete: Cascade)

  @@index([chatSessionId, createdAt])
}

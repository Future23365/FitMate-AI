{
  "name": "ai-fitness-assistant",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "echo \"AI Trace 调试台: http://localhost:3000/dev/ai-traces\"",
    "dev": "node scripts/dev-with-error-log.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "test:llm": "node scripts/run-manual-llm-tests.mjs",
    "typecheck": "tsc --noEmit",

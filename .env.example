# DATABASE_URL 是 PostgreSQL 连接串；本地 compose.yaml 默认账号为 fitmate/fitmate。
DATABASE_URL="postgresql://fitmate:fitmate@localhost:5432/fitmate?schema=public"

# DEEPSEEK_API_KEY 是生产 /api/chat 和手动 LLM 黑盒测试调用真实模型的密钥。
DEEPSEEK_API_KEY=

# DEEPSEEK_API_URL 可选；留空时使用代码中的默认 DeepSeek endpoint。
DEEPSEEK_API_URL=

# DEEPSEEK_MODEL 可选；留空时使用集中配置中的默认模型。
DEEPSEEK_MODEL=

# FITMATE_LOCAL_AUTH_SECRET 用于签发和校验本地匿名 auth cookie；生产环境必须填写强随机值。
FITMATE_LOCAL_AUTH_SECRET=

# FITMATE_ADMIN_USER_IDS 是允许访问 /admin 后台的 userId 列表，使用逗号或空白分隔；未配置时后台默认拒绝。
FITMATE_ADMIN_USER_IDS=

# CONFIRMATION_TOKEN_SECRET 用于高影响操作确认 token 签名；生产环境建议显式填写强随机值。
CONFIRMATION_TOKEN_SECRET=

# EXERCISE_IMAGE_LOCAL_DIR 是动作图片本地目录，相对项目根目录或绝对路径均可。
EXERCISE_IMAGE_LOCAL_DIR=exercises_picture

# EXERCISE_IMAGE_PUBLIC_BASE_URL 是前端访问动作图片的基础 URL；默认走站内受控 Route。
EXERCISE_IMAGE_PUBLIC_BASE_URL=/api/exercise-images

# ENABLE_AI_TRACE_LOG 控制生产环境是否写入 AI trace；公开环境建议保持空或 false。
ENABLE_AI_TRACE_LOG=
